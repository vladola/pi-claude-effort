{
  "name": "pi-claude-effort",
  "version": "0.1.0",
  "description": "Pi extension: Claude models default to one thinking level below max, with per-model user overrides",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "claude",
    "thinking-level",
    "reasoning-effort"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.0.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladola/pi-claude-effort.git"
  },
  "homepage": "https://github.com/vladola/pi-claude-effort",
  "bugs": {
    "url": "https://github.com/vladola/pi-claude-effort/issues"
  }
}
